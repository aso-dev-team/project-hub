# Canonical local development uses .devcontainer/docker-compose.yml.
# This file is for direct local runs and other manual experiments.

# Web
NEXT_PUBLIC_APP_API_URL=http://localhost:5050
NEXT_PUBLIC_APP_GRAPHQL_URL=http://localhost:5050/graphql
NEXT_PUBLIC_SIGNALR_HUB_URL=http://localhost:5050/hubs/board
NEXT_PUBLIC_DEFAULT_TEAM_ID=team-product
NEXT_PUBLIC_DEFAULT_PROJECT_ID=project-roadmap

# ASP.NET Core API
ASPNETCORE_URLS=http://localhost:5050
ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=linear_like;Username=postgres;Password=postgres
Web__Origin=http://localhost:3000
Demo__InternalServiceApiKey=dev-internal-service-key

# ext-api (exploratory external surface)
EXT_API_ADDR=:8081
APP_API_BASE_URL=http://localhost:5050
INTERNAL_SERVICE_API_KEY=dev-internal-service-key
